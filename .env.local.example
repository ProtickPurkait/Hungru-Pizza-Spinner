# Upstash Redis — auto-populated in Vercel if you use the "Connect Store" /
# Storage tab integration. For local dev, copy the REST URL/token from your
# Upstash dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login password (shown on the /admin/login page).
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
ADMIN_COOKIE_SECRET=replace-with-a-long-random-string

# Optional. Public URL of the deployed site, used to generate the QR code.
# If unset, the QR code falls back to the request's own origin.
NEXT_PUBLIC_SITE_URL=
